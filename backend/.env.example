# Choose: auto, local, ollama, or openai
LLM_PROVIDER=auto

# Ollama example: ollama pull llama3.2:3b
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434

# OpenAI example. Keep this file server-side and never commit the real key.
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-with-a-new-openai-api-key

LLM_TIMEOUT_SECONDS=45

# Supabase persistence (server-side only)
SUPABASE_URL=https://tgqjilgdnyzktppkybmu.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_CHAT_TABLE=Chat_History
ADMIN_EMAILS=admin@example.com
